# Copy the names into Vercel → Project → Settings → Environment Variables. Never commit real values.

# Drive access: a Google Cloud service account with view access to the files below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Sign-in: an OAuth client (Web application) whose redirect URI is https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Only on a custom domain; Vercel sets the URL itself otherwise.
# NEXTAUTH_URL=https://round.example.org

# Who may sign in: addresses and/or whole domains, comma-separated. Nobody gets in while both are empty.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional overrides; the defaults are the IDs in the brief.
# IDP_DATA_FOLDER_ID=1kNvxUpXlgXFFjcL9v_76arZeZPq9chQC
# CULTURES_FOLDER_ID=1rJ7F0-t_28RvROKJ66OvnU1TmdaxT2yB
# AMS_2024_2025_FILE_ID=1_VOfykZ7ePRx-Y9563XNIka5FXTiWbqO
# AMS_2025_2026_FILE_ID=            (else found by name: LAU_AMS_…2025_2026_cleaned_in_original_format.xlsx)
# REGISTER_FILE_ID=1fbnZdqW0U_L19kcvIG47CvUOM90w9YxMA-DQjRrRRxM
